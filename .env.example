# Copia este archivo como .env (o exporta las variables en tu terminal) para
# activar el autocompletado desde APIs reales.

# API-Football y API-Basketball comparten cuenta/clave (api-sports.io).
# Regístrate gratis (100 peticiones/día) en https://dashboard.api-football.com
API_SPORTS_KEY=

# Para tenis (Tennis API ATP/WTA/ITF en RapidAPI).
# Regístrate en https://rapidapi.com/ y suscríbete al plan gratuito de esa API.
RAPIDAPI_KEY=

# Para cuotas reales y detección de value bets (The Odds API).
# Regístrate gratis (500 peticiones/mes) en https://the-odds-api.com/
ODDS_API_KEY=
